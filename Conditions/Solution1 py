# Function to categorize age
def categorize_age(age):
    if age < 13:
        return "Child"
    elif 13 <= age <= 19:
        return "Teenager"
    elif 20 <= age <= 59:
        return "Adult"
    elif age >= 60:
        return "Senior"
    else:
        return "Invalid age"

# Main program
try:
    user_age = int(input("Enter your age: "))
    
    if user_age < 0:
        print("Please enter a positive number.")
    else:
        category = categorize_age(user_age)
        print(f"Age Category: {category}")
        
except ValueError:
    print("Invalid input. Please enter a whole number.")
